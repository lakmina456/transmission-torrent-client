# Copy to the VPS only — NEVER commit the real file:
#   sudo cp updater.env.example /etc/cloudseed/updater.env
#   sudo chmod 600 /etc/cloudseed/updater.env
#   sudo chown root:root /etc/cloudseed/updater.env
#
# Generate a strong token:
#   openssl rand -hex 32

UPDATE_TOKEN=PASTE_OPENSSL_RAND_HEX_32_HERE

# Optional overrides (defaults shown)
# CLOUDSEED_REPO=/opt/cloudseed/src
# CLOUDSEED_WEB=/var/lib/transmission-daemon/info/web
# CLOUDSEED_BRANCH=main
# CLOUDSEED_REMOTE=origin
# DEPLOY_SCRIPT=/opt/cloudseed/deploy.sh
# DEPLOY_TIMEOUT=600
# CHECK_TIMEOUT=120
# PORT=5002
